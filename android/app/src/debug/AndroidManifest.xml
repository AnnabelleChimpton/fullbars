<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: adb-driven test control. Never present in release builds.
  Both entry points need android.permission.DUMP, which adb's shell holds and ordinary apps can't be granted, so no
  other app on the phone can end the stream, unmute or leave Privacy through them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.irlsupreme.debug.CONTROL" />
            </intent-filter>
        </receiver>

        <!--
          Applies debug_* extras, then opens MainActivity and closes. Translucent: nothing flashes on screen.
          Its own task (empty affinity): otherwise, once it has started the app, it is the app task's root, and the next
          `am start` of it just brings that task forward and drops the extras.
        -->
        <activity
            android:name=".debug.DebugActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
